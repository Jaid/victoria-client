{
  "name": "victoria-client",
  "displayName": "VictoriaClient",
  "version": "0.3.0",
  "type": "module",
  "description": "powerful abstractions for collecting and pushing data to VictoriaLogs, VictoriaTraces and VictoriaMetrics",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/victoria-client.git"
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./bun": {
      "types": "./src/bun/main.ts",
      "default": "./src/bun/main.ts"
    },
    "./sqlite": {
      "types": "./src/storage/SqliteOutbox.ts",
      "default": "./src/storage/SqliteOutbox.ts"
    },
    "./otel": {
      "types": "./src/otel/main.ts",
      "default": "./src/otel/main.ts"
    },
    "./delivery": {
      "types": "./src/delivery/main.ts",
      "default": "./src/delivery/main.ts"
    },
    "./browser": {
      "types": "./src/browser/main.ts",
      "default": "./src/browser/main.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run readme && bun scripts/build.ts",
    "lint": "eslint . --max-warnings 0",
    "readme": "bun tldw",
    "test": "bun test --max-concurrency 1 ./test",
    "test:packages": "bun run build && bun scripts/verifyPackages.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "compose-id": "0.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/otlp-transformer": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "eslint-config-jaid": "37.1.0",
    "fs-extra": "11.4.1",
    "tldw": "9.9.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.6",
    "@types/bun": "1.4.4",
    "@types/fs-extra": "11.0.4"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "readme.md",
    "license.txt"
  ],
  "sideEffects": false
}